# Core
abbr -a g git
abbr -a gs 'git status'

# Add
abbr -a ga 'git add'
abbr -a gap 'git add -p'
abbr -a gau 'git add -u'

# Branch
abbr -a gb 'git branch'
abbr -a gbd 'git branch -d'
abbr -a gbD 'git branch -D'

# Checkout / Switch
abbr -a gch 'git checkout'
abbr -a gchb 'git checkout -b'
abbr -a gchm 'git checkout main'
abbr -a gsw 'git switch'
abbr -a gswc 'git switch -c'

# Commit
abbr -a gc 'git commit'
abbr -a gca 'git commit -a'
abbr -a gcaa 'git commit -a --amend'
abbr -a gcam 'git commit -am'
abbr -a gcm 'git commit -m'

# Diff
abbr -a gd 'git diff'
abbr -a gdc 'git diff --cached'

# Fetch / Pull / Push
abbr -a gf 'git fetch'
abbr -a gfo 'git fetch origin'
abbr -a gfu 'git fetch upstream'
abbr -a gpul 'git pull'
abbr -a gpulo 'git pull origin'
abbr -a gpulu 'git pull upstream'
abbr -a gpus 'git push'
abbr -a gpusf 'git push --force-with-lease'
abbr -a gpusu 'git push -u'
abbr -a gpusuo 'git push -u origin'

# Log
abbr -a gl 'git log'
abbr -a glG 'git log -G'
abbr -a glo 'git log --oneline'

# Merge / Rebase
abbr -a gm 'git merge'
abbr -a gr 'git rebase'
abbr -a gri 'git rebase -i'

# Stash
abbr -a gst 'git stash'
abbr -a gsp 'git stash pop'

# Submodule
abbr -a gsu 'git submodule update'
abbr -a gsui 'git submodule update --init'
abbr -a gsuir 'git submodule update --init --recursive'

# Utility
abbr -a grm 'git remote'
abbr -a grp 'git rev-parse'
abbr -a gsh 'git show'
