animations {
    // Global speed multiplier. Keep at 1.0 for the intended physics feel.
    // slowdown 1.0

    workspace-switch {
        // High stiffness, perfect damping = fast, no overshoot.
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    window-open {
        // Slight overshoot (0.8) makes windows "pop" into existence.
        spring damping-ratio=0.8 stiffness=1000 epsilon=0.0001
    }

    window-close {
        // Quick fade out with a slight downward drift (using your shader logic)
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    horizontal-view-movement {
        // This governs the "scrolling" feel. Needs to be very snappy.
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-resize {
        // Fast resizing prevents "texture stretching" artifacts during the transition.
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
}
