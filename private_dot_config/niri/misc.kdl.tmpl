// === Startup Services ===

// 1. IMPORT ENVIRONMENT (The Reliable Way)
// This tells systemd and D-Bus about Niri's Wayland socket.
spawn-at-startup "systemctl" "--user" "import-environment" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP" "XDG_SESSION_TYPE" "QT_QPA_PLATFORMTHEME" "QT_IM_MODULE" "XMODIFIERS"

// 2. Launch UI Shell
spawn-at-startup "uwsm" "app" "--" "qs" "-c" "noctalia-shell"

// 3. Launch Fcitx5 (With 2s delay)
spawn-at-startup "uwsm" "app" "--" "sh" "-c" "sleep 2; fcitx5 -rd"

// 4. Other apps
spawn-at-startup "uwsm" "app" "--" "alacritty" "-e" "fish"
spawn-at-startup "uwsm" "app" "--" "wlsunset" "-l" "21.03" "-L" "105.85" "-t" "6500" "3000"

// 5. Portable Update Script
spawn-at-startup "fish" "{{ .chezmoi.homeDir }}/.local/bin/check_and_update.fish"

// === Alt-Tab Behavior (Recent Windows) ===
recent-windows {
    highlight {
        corner-radius 14
    }

    previews {
        max-height 320
    }

    // Restore these for fast task switching
    binds {
        Mod+Tab          { next-window scope="output"; }
        Mod+Shift+Tab    { previous-window scope="output"; }
        Mod+grave        { next-window filter="app-id" scope="output"; }
        Mod+Shift+grave  { previous-window filter="app-id" scope="output"; }
    }
}

// === Wayland Environment Fixes ===
environment {
    // Keep UI-specific theme and input variables here
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_IM_MODULE "fcitx"
    XMODIFIERS "@im=fcitx"
    SDL_IM_MODULE "fcitx"
    _JAVA_AWT_WM_NONREPARENTING "1"

    XDG_DATA_DIRS "{{ .chezmoi.homeDir }}/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share"

    // Explicitly set this to help UWSM recognize the session
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
}

// === Visuals & Interaction ===
overview {
    workspace-shadow {
        on
        softness 60
        color "#000000a0"
    }
}

cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
}

hotkey-overlay {
    skip-at-startup
}

clipboard {
    // Disabling primary (middle-click paste) prevents accidental pastes in terminals
    disable-primary
}

// Ensure XWayland is available for legacy apps
xwayland-satellite {
    // spawn-at-startup
}
