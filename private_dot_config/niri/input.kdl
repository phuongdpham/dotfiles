input {
    keyboard {
        xkb {
            layout "us"
            // Caps to Ctrl is essential for Vim-style workflows
            options "compose:ralt,ctrl:nocaps,altwin:swap_lalt_lwin"
        }

        // Snappier repeat settings for fast scrolling/navigating
        repeat-delay 200
        repeat-rate 45
    }

    touchpad {
        tap
        natural-scroll
        accel-speed 0.2 // Reduced slightly for better precision on high-DPI screens
        dwt // Disable While Typing: prevents accidental palm clicks
    }

    mouse {
        // Most gaming/pro mice feel better with flat profile (no acceleration)
        // accel-profile "flat" 
        natural-scroll
    }

    trackpoint {
        natural-scroll
    }

    tablet {
        map-to-output "eDP-1"
    }

    touch {
        off // Keeps things minimalist if you don't use the touchscreen
    }

    // Modern Workflow Tweak
    // Allows you to focus windows by hovering, but '0%' prevents accidental
    // workspace scrolling when your mouse hits the edge of a screen.
    focus-follows-mouse max-scroll-amount="0%"
}
