# --- 1. System Recovery Path (Senior Safety) ---
# We put system paths FIRST to ensure core binaries are always found.
export PATH="/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:{{ .chezmoi.homeDir }}/.local/bin:{{ .chezmoi.homeDir }}/go/bin:{{ .chezmoi.homeDir }}/.cargo/bin:$PATH"

# --- 2. Tooling & Backend (88labs) ---
export EDITOR="nvim"
export VISUAL="nvim"
export TERMINAL="alacritty"
export GOPATH="{{ .chezmoi.homeDir }}/go"

{{- if .goprivate }}
export GOPRIVATE="{{ .goprivate }}"
{{- end }}
export CGO_ENABLED="0"

# --- 3. Wayland Fixes (Moved back to Env for early loading) ---
export QT_QPA_PLATFORM="wayland"
export GDK_BACKEND="wayland,x11"
export MOZ_ENABLE_WAYLAND=1
