# --- 1. Tooling & Backend (88labs) ---
export EDITOR="nvim"
export VISUAL="nvim"
export TERMINAL="alacritty"
export GOPATH="{{ .chezmoi.homeDir }}/go"

{{- if .goprivate }}
# Only exported if a domain was provided during init
export GOPRIVATE="{{ .goprivate }}"
{{- end }}

export CGO_ENABLED="0"

# --- 2. Base Path ---
# We keep this here so your Go tools work in a TTY/Console.
export PATH="{{ .chezmoi.homeDir }}/.local/bin:{{ .chezmoi.homeDir }}/go/bin:{{ .chezmoi.homeDir }}/.cargo/bin:$PATH"
