# ==========================================
# Fish Shell
# ==========================================

# Universal variables (Contains machine-specific state and paths, DO NOT TRACK)
.config/fish/fish_variables

# Fisher plugin manager binary (We install this via your run_onchange_ script)
.config/fish/functions/fisher.fish

# Auto-generated completions (usually generated by tools like Rustup, FNM, etc.)
.config/fish/completions/*
# (If you ever write a custom completion you WANT to keep, uncomment the line below)
# !.config/fish/completions/my_custom_script.fish

# Ignore Tide prompt files (managed by Fisher)
.config/fish/functions/tide/
.config/fish/functions/tide.fish
.config/fish/functions/_tide_*.fish
.config/fish/functions/fish_prompt.fish
.config/fish/functions/fish_mode_prompt.fish

# Ignore Tide plugin files in conf.d
.config/fish/conf.d/_tide_init.fish
.config/fish/conf.d/*tide*.fish


# ==========================================
# Neovim (Lazy.nvim / General)
# ==========================================

# Netrw history file (auto-generated by Neovim's built-in file explorer)
.config/nvim/.netrwhist

# Compiled spell-check dictionaries (these are generated locally from your .add files)
.config/nvim/spell/*.add.spl
.config/nvim/spell/*.add.sug

# Temporary files (Modern Neovim usually puts these in ~/.local/state, but just in case)
.config/nvim/undo/
.config/nvim/swap/
.config/nvim/backup/
.config/nvim/**/*.swp

# ==========================================
# Noctalia Shell
# ==========================================

# 1. Dynamically generated color schemes and themes
# (Noctalia creates these automatically when your wallpaper changes)
.config/noctalia/generated/*
.config/noctalia/colors.json
.config/noctalia/theme.css

# 2. Downloaded Wallpapers
# (Ignore this folder so you aren't pushing hundreds of megabytes of Wallhaven images to your Git repo)
.config/noctalia/wallpapers/*
# Optional: Uncomment the line below to track ONE specific default wallpaper
# !.config/noctalia/wallpapers/my-default-arch-bg.png

# 3. Runtime state and caches
# (Stores things like "is the control center open right now?" or widget positions)
.config/noctalia/state.json
.config/noctalia/cache/*
.config/noctalia/**/*.cache


# ==========================================
# General / OS Artifacts
# ==========================================

# Editor backups and temp files
*~
*.bak
*.tmp

# Arch/Linux specific
.Xauthority
.ICEauthority
.bash_history
.zsh_history

# If you ever copy files from macOS or Windows
**/.DS_Store
Thumbs.db
