#!/bin/bash

# fish_plugins hash: {{ include "private_dot_config/private_fish/fish_plugins" | sha256sum }}

if ! command -v fish &> /dev/null; then
    echo "Fish is not installed. Skipping Fisher setup."
    exit 0
fi

echo "Setting up Fish shell and plugins..."

fish -c '
    if not type -q fisher
        echo "Installing Fisher plugin manager..."
        curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source && fisher install jorgebucaran/fisher
    end

    echo "Updating Fish plugins..."
    fisher update
'

echo "Fish setup complete!"

